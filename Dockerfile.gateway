# Staging-only fail-closed API gateway. No production secrets are baked in.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY backend/requirements.txt /srv/backend/requirements.txt
RUN python -m pip install --no-cache-dir -r /srv/backend/requirements.txt \
 && useradd --system --create-home --uid 10001 batlokoa
COPY backend/ /srv/backend/
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=2)" || exit 1
CMD ["uvicorn","backend.app.main:app","--host","0.0.0.0","--port","8000","--proxy-headers=false"]
